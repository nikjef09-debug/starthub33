# Скопируйте этот файл в .env и заполните значения:
# cp .env.example .env

# ОБЯЗАТЕЛЬНО — секрет для JWT (минимум 32 случайных символа)
SECRET_KEY=замените-на-случайную-строку-минимум-32-символа

# Email для отправки писем (SMTP mail.ru)
EMAIL_USER=your@mail.ru
EMAIL_PASS=ваш-пароль-из-настроек-почты

# URL приложения БЕЗ слэша в конце
APP_BASE_URL=https://starthub33.ru

# Email для получения заявок с контактной формы
CONTACT_EMAIL=info@starthub33.ru
